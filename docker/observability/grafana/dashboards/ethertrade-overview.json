    {
      "datasource": { "type": "prometheus", "uid": "default" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "id": 10,
      "title": "Active WebSocket Connections",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(ethertrade_ws_active_connections)",
