{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "roots": ["<rootDir>/apps/", "<rootDir>/libs/"],
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "@swc/jest",
      {
        "jsc": {
          "target": "es2022",
          "parser": {
            "syntax": "typescript",
            "decorators": true,
            "dynamicImport": true
          },
          "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
          }
        }
      }
    ]
  },
  "collectCoverageFrom": [
    "apps/**/*.{ts,js}",
    "libs/**/*.{ts,js}",
    "!**/*.spec.ts",
    "!**/*.integration-spec.ts",
    "!**/*.d.ts",
    "!**/node_modules/**",
    "!**/dist/**",
    "!**/test/**",
    "!**/main.ts",
    "!**/*.module.ts",
    "!**/*.config.ts",
    "!**/drizzle.config.ts",
    "!**/migrate.ts",
    "!**/*.schema.ts",
    "!**/*.constants.ts",
    "!**/*.validation.ts",
    "!**/*.controller.ts",
    "!**/*.repository.ts",
    "!**/*.filter.ts",
    "!**/*.swagger.ts",
    "!**/dto/**",
    "!**/*.dto.ts",
    "!**/guards/**",
    "!**/*.guard.ts",
    "!**/decorators/**",
    "!**/*.decorator.ts",
    "!**/middleware/**",
    "!**/*.strategy.ts",
    "!apps/api-gateway/**",
    "!**/blockchain/**",
    "!**/processors/**",
    "!libs/contracts/src/**"
  ],
  "coverageDirectory": "./coverage",
  "testEnvironment": "node",
  "transformIgnorePatterns": [
    "node_modules/(?!(uuid)/)"
  ],
  "moduleNameMapper": {
    "^uuid$": "<rootDir>/test/mocks/uuid.ts",
    "^@app/common/(.*)$": "<rootDir>/libs/common/src/$1",
    "^@app/common$": "<rootDir>/libs/common/src/index.ts",
    "^@app/contracts/(.*)$": "<rootDir>/libs/contracts/src/$1",
    "^@app/contracts$": "<rootDir>/libs/contracts/src/index.ts"
  }
}
