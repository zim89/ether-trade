{
  "name": "et-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "_APP": "###########",
    "build": "nest build",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\"",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start api-gateway --watch",
    "start:dev:identity": "nest start identity --watch",
    "start:dev:accounts": "nest start accounts --watch",
    "start:dev:orders": "nest start orders --watch",
    "start:dev:transfers": "nest start transfers --watch",
    "auth:sign": "pnpm tsx scripts/generate-siwe.ts",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main",
    "contracts:build": "docker run --rm --entrypoint forge -v \"$(pwd):/app\" -w /app ghcr.io/foundry-rs/foundry:latest build && node -e \"const fs=require('fs');const dv=JSON.parse(fs.readFileSync('./out/deposit-vault.sol/DepositVault.json','utf8'));const usdt=JSON.parse(fs.readFileSync('./out/mock-usdt.sol/MockUSDT.json','utf8'));fs.mkdirSync('./libs/contracts/src/transfers/artifacts',{recursive:true});fs.writeFileSync('./libs/contracts/src/transfers/artifacts/deposit-vault.json',JSON.stringify({abi:dv.abi,bytecode:dv.bytecode.object},null,2));fs.writeFileSync('./libs/contracts/src/transfers/artifacts/mock-usdt.json',JSON.stringify({abi:usdt.abi,bytecode:usdt.bytecode.object},null,2));console.log('Artifacts extracted successfully');\"",
    "contracts:deploy": "pnpm tsx scripts/deploy-contracts.ts",
    "proto:generate": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=libs/contracts/src/generated --ts_proto_opt=nestJs=true,addGrpcMetadata=true,fileSuffix=.pb --proto_path=libs/contracts/proto libs/contracts/proto/*.proto",
    "_DOCKER": "###########",
    "docker:up": "docker compose -f docker/docker-compose.dev.yml up -d --wait",
    "docker:down": "docker compose -f docker/docker-compose.dev.yml down",
    "docker:down:v": "docker compose -f docker/docker-compose.dev.yml down -v",
    "docker:logs": "docker compose -f docker/docker-compose.dev.yml logs -f",
    "_DB": "###########",
    "db:generate:identity": "drizzle-kit generate --config=apps/identity/drizzle.config.ts",
    "db:generate:accounts": "drizzle-kit generate --config=apps/accounts/drizzle.config.ts",
    "db:generate:orders": "drizzle-kit generate --config=apps/orders/drizzle.config.ts",
    "db:generate:transfers": "drizzle-kit generate --config=apps/transfers/drizzle.config.ts",
    "db:generate": "pnpm db:generate:identity && pnpm db:generate:accounts && pnpm db:generate:orders && pnpm db:generate:transfers",
    "db:migrate:identity": "pnpm tsx --tsconfig tsconfig.json apps/identity/src/database/migrate.ts",
    "db:migrate:accounts": "pnpm tsx --tsconfig tsconfig.json apps/accounts/src/database/migrate.ts",
    "db:migrate:orders": "pnpm tsx --tsconfig tsconfig.json apps/orders/src/database/migrate.ts",
    "db:migrate:transfers": "pnpm tsx --tsconfig tsconfig.json apps/transfers/src/database/migrate.ts",
    "db:migrate": "pnpm db:migrate:identity && pnpm db:migrate:accounts && pnpm db:migrate:orders && pnpm db:migrate:transfers",
    "_TEST": "###########",
    "check": "pnpm lint && pnpm tsc --noEmit && pnpm test:unit && pnpm test:contracts",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --config ./jest.unit.json --passWithNoTests",
    "test:integration": "jest --config ./jest.integration.json --runInBand --passWithNoTests",
    "test:e2e": "jest --config ./jest.e2e.json --runInBand --passWithNoTests",
    "test:contracts": "buf breaking libs/contracts --against '.git#branch=main,subdir=libs/contracts'",
    "test:all": "pnpm test:unit && pnpm test:integration",
    "test:watch": "jest --config ./jest.unit.json --watch",
    "test:cov": "jest --config ./jest.unit.json --coverage",
    "test:cov:all": "jest --coverage --runInBand --passWithNoTests",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prepare": "husky"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.2.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^11.4.7",
    "@valkey/valkey-glide": "^2.5.1",
    "argon2": "^0.45.1",
    "bignumber.js": "^11.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "kafkajs": "^2.2.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.2",
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.12.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "volta": {
    "node": "22.23.2",
    "pnpm": "12.4.2"
  }
}
