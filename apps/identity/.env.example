# Identity Service Environment Variables (.env.example)

# Application
NODE_ENV=development
IDENTITY_GRPC_URL=0.0.0.0:50051

# Database (PostgreSQL)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=identity_db
DB_MAX_CONNECTIONS=10

# Redis / Valkey
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth / JWT Secrets (Fail-fast: required in all environments)
JWT_SECRET=super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
